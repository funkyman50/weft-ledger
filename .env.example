# Development only (./weft dev). The installed runtime keeps its key in its data folder.
# Generate once with: python3 -c 'import secrets; print(secrets.token_hex(32))'
# Preserve this key. Replacing it without re-encryption breaks saved connections.
WEFT_DEV_SECRET=
# Login passwords are optional; configure them in System settings → Security.
# Set up optional bank connections in System settings → Plaid.
# Optional; defaults to logs/<database filename>/ beside the database.
WEFT_LOG_DIR=

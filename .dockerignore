# Only inputs used by backend/Dockerfile enter the build context.
**
!backend/Dockerfile
!backend/pyproject.toml
!backend/uv.lock
!backend/app/**/*.py
!backend/app/**/*.sql
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig*.json
!frontend/vite.config.ts
!frontend/src/**/*.ts
!frontend/src/**/*.tsx
!frontend/src/**/*.css
!frontend/src/**/*.png
!frontend/public/*.png
!frontend/notices/*.txt
!LICENSE
!NOTICE
!THIRD_PARTY_NOTICES.md
**/.env*
**/*.local
**/*.local.*
**/node_modules/**
**/dist/**
**/__pycache__/**
**/.claude/**
**/.codex/**
**/.playwright-cli/**
**/.firecrawl/**
**/.superpowers/**
backend/app/static/**
